# Keep secrets out of source control. The SQL Analyst reads these at request time.
# Supported providers: gemini (default) and ollama. Blank values are treated as unset.
LLM_PROVIDER=gemini
# Optional model override. Gemini default: gemini-2.5-flash.
# Ollama default: qwen2.5-coder:7b (served at http://localhost:11434).
LLM_MODEL=
# Required when LLM_PROVIDER=gemini. Never commit a real key.
LLM_API_KEY=
# Upload cap in bytes (25 MiB). Also caps SQLite database uploads in the SQL Analyst.
AIDA_MAX_UPLOAD_BYTES=26214400
# Maximum data rows per dataset.
AIDA_MAX_ROWS=250000
# Maximum data columns per dataset.
AIDA_MAX_COLUMNS=200
# Analysis execution budget in seconds.
AIDA_MAX_EXECUTION_SECONDS=30
# Per-query SQL timeout in seconds.
AIDA_SQL_TIMEOUT_SECONDS=5
# Maximum rows returned by one query.
AIDA_MAX_RESULT_ROWS=1000
